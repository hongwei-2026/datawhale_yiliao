# Agnes AI（勿提交真实密钥；复制本文件为 .env 后填写）
AGNES_API_KEY=your_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# MiniMax 语音合成（受试者旁白；密钥勿提交）
MINIMAX_API_KEY=your_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=male-qn-qingse
MINIMAX_VOICE_SPEED=0.95
MINIMAX_VOICE_EMOTION=calm

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/sp_training.db
