# Agnes AI（勿提交真实密钥；复制本文件为 .env 后填写）
AGNES_API_KEY=your_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# MiniMax 语音合成（受试者旁白；密钥勿提交）
MINIMAX_API_KEY=your_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=male-qn-qingse
MINIMAX_VOICE_SPEED=0.95
MINIMAX_VOICE_EMOTION=calm
# 说话数字人：本地无 GPU 时用 MiniMax H3（慢）；云端请用 Linly-Talker/MuseTalk 并设 TALKING_HEAD_ENABLED=false
TALKING_HEAD_ENABLED=false
TALKING_HEAD_RESOLUTION=768P
TALKING_HEAD_TIMEOUT_SEC=120
# MuseTalk GPU 口型（云端同机部署 scripts/deploy_musetalk.py）
MUSETALK_ENABLED=true
MUSETALK_BASE_URL=http://127.0.0.1:8770
MUSETALK_TIMEOUT_SEC=60
# 诊室背景/肖像生成（python scripts/generate_persona_assets.py --all）

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/sp_training.db

# 登录令牌（生产环境请改为随机长字符串）
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=604800
